// Session-scoped variables. These do not leak into the Plasma session.
environment {
    QT_QPA_PLATFORMTHEME "gtk3"
    DISPLAY ":1"
}

// Don't show the hotkey cheatsheet on every login (Mod+Shift+/ still opens it).
hotkey-overlay {
    skip-at-startup
}

input {
    keyboard {
        // Turn Num Lock on at session start.
        numlock

        xkb {
            layout "us"
            variant "intl"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0006"
    }
}

// No server-side decorations — clean tiling look.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// Unfocused windows are slightly translucent.
window-rule {
    opacity 0.95
}

window-rule {
    match is-active=true
    opacity 1.0
}

// Rounded corners.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Password prompts float instead of joining the scrollable strip.
window-rule {
    match app-id=r#"^org\.kde\.polkit-kde-authentication-agent-1$"#
    open-floating true
}

animations {
    slowdown 0.8
}

// X11 support for apps like Steam. Serves DISPLAY set above.
spawn-at-startup "xwayland-satellite"

// The shell needs the compositor to settle first, hence the delay.
spawn-at-startup "sh" "-c" "sleep 2 && noctalia-shell"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications
    Mod+T { spawn "kitty"; }
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "dolphin"; }
    Mod+B { spawn "firefox"; }

    // Launcher
    Mod+D { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Space { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }

    // Window management
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Move windows within the strip
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Column width
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Jump to a workspace by number
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // Cycle through workspaces
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+Up   { focus-workspace-up; }
    Mod+Tab       { focus-workspace-previous; }

    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Screenshots
    Mod+Shift+S { screenshot; }
    Mod+Shift+F12 { screenshot-screen; }
    Mod+Shift+W { screenshot-window; }

    // Media and brightness keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Session
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
