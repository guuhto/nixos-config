// ~/nixos/config/niri/config.kdl

// Variáveis válidas só dentro da sessão niri — não afetam o Plasma.
environment {
    QT_QPA_PLATFORMTHEME "gtk3"
    DISPLAY ":1"
}

input {
    keyboard {
        xkb {
            layout "us"
            variant "intl"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0006"
    }
}

// Sem decoração do servidor — visual limpo de tiling.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// Janelas inativas ficam levemente translúcidas.
window-rule {
    opacity 0.95
}

window-rule {
    match is-active=true
    opacity 1.0
}

// Cantos arredondados.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Diálogos abrem flutuando em vez de entrar na faixa.
window-rule {
    match app-id=r#"^org\.kde\.polkit-kde-authentication-agent-1$"#
    open-floating true
}

animations {
    slowdown 0.8
}

spawn-at-startup "xwayland-satellite"
spawn-at-startup "sh" "-c" "sleep 2 && noctalia-shell"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Aplicativos
    Mod+T { spawn "kitty"; }
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "dolphin"; }
    Mod+B { spawn "firefox"; }

    // Janelas
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }

    // Foco
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Mover
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Largura da coluna
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // Capturas
    Mod+Shift+S { screenshot; }
    Mod+Shift+F12 { screenshot-screen; }
    Mod+Shift+W { screenshot-window; }

    // Mídia e volume
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Sessão
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
