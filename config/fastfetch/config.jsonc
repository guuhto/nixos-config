{
    "logo": {
        "source": "~/.config/fastfetch/ascii/nixos.txt",
         "color": {
            "1": "38;5;218"
        },
        "padding": {
            "top": 2,
            "right": 5
        }
    },
    "display": {
        "separator": " ➜ "
    },
    "modules": [
        "break",
        "break",


        {
            "type": "os",
            "key": "OS",
            "keyColor": "38;5;218"
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "38;5;218"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ├ 󰏖 ",
            "keyColor": "38;5;218"
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "38;5;218"
        },

        "break",

        // --- INTERFACE ---
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "38;5;218"
        },
        {
            "type": "wmtheme",
            "key": " ├  ",
            "keyColor": "38;5;218"
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "38;5;218"
        },
        {
            "type": "cursor",
            "key": " ├ 󰆏 ",
            "keyColor": "38;5;218"
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "38;5;218"
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "38;5;218"
        },

        "break",

        // --- HARDWARE ---
        {
            "type": "host",
            "format": "{5} {1} Type {2}",
            "key": "PC",
            "keyColor": "38;5;218"
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}GHz",
            "key": " ├  ",
            "keyColor": "38;5;218"
        },
        {
            "type": "gpu",
            "format": "{1} {2} @ {12}GHz",
            "key": " ├ 󰢮 ",
            "keyColor": "38;5;218"
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "38;5;218"
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "38;5;218"
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "38;5;218"
        },
        {
            "type": "monitor",
            "key": " └  ",
            "keyColor": "38;5;218"
        },
	"break", 
	"break", 
	"break", 
    ] 
}
